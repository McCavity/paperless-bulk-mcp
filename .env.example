# Paperless-ngx instance URL (no trailing slash)
PAPERLESS_URL=http://192.168.178.168:8001

# API Token
# - Generate via Paperless UI: User Settings → API Auth Token
# - Or copy from existing ~/.mcp.json under mcpServers.papercortex.env.PAPERLESS_TOKEN
# - Never commit the real value — keep it in .env (gitignored) or 1Password
PAPERLESS_TOKEN=replace_me

# Optional: HTTP timeout for bulk operations in seconds (default 60)
# PAPERLESS_TIMEOUT=60

# Optional: tag ID for the inbox (e.g. '💡 Eingang' in Henning's setup → 9).
# When set, list_inbox skips the /api/tags/ lookup. Recommended in production;
# without it the server does a one-time name lookup and caches the result for
# the process lifetime. Required if multiple tags match 'eingang' (ambiguous).
# PAPERLESS_INBOX_TAG_ID=9
